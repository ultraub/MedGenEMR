    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.19.0",
    "cornerstone-core": "^2.6.1",
    "cornerstone-tools": "^6.0.0",
    "cornerstone-wado-image-loader": "^4.1.0",
    "d3": "^7.9.0",
    "date-fns": "^3.6.0",
    "dicom-parser": "^1.8.0",
    "dompurify": "^3.4.13",
    "framer-motion": "^12.42.2",
    "fuse.js": "^7.5.0",
    "hammerjs": "^2.0.8",
    "notistack": "^3.0.2",
    "react": "^18.2.0",
    "react-chrono": "^2.9.1",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^1.5.2",
    "react-hotkeys-hook": "^4.6.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.1",
    "react-transition-group": "^4.4.5",
    "recharts": "^3.10.1",
    "uuid": "^11.1.1",
    "vis-data": "^8.0.4",
    "vis-timeline": "^8.5.3",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "vite",
    "dev": "REACT_APP_ENVIRONMENT=development vite",
    "dev:staging": "REACT_APP_ENVIRONMENT=staging vite",
    "build": "vite build && node scripts/postbuild-sw.js",
    "build:staging": "REACT_APP_ENVIRONMENT=staging vite build && node scripts/postbuild-sw.js",
    "build:production": "REACT_APP_ENVIRONMENT=production vite build && node scripts/postbuild-sw.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "analyze": "ANALYZE=true npm run build",
    "serve": "npx serve -s build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.39.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^6.0.11",
    "typescript": "^4.9.5",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^28.14.0",
    "eslint-plugin-testing-library": "^7.6.0",
    "globals": "^15.15.0"
  },
  "overrides": {
    "js-yaml": "^4.3.0",
    "postcss": "^8.5.18"
  }
}
